{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-01",
  "name": "pronouns-blue",
  "workers_dev": false,
  "preview_urls": false,
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
  },
}
